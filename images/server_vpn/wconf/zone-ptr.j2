$ORIGIN {{ VPN_NETWORK | iplib_ptr }}.
$TTL 300

@ IN SOA ns.{{ VPN_DNS_ZONE }}. admin.{{ VPN_DNS_ZONE }}. (
    {{ VPN_DNS_ZONE_SERIAL }} ; serial
    300        ; refresh
    120        ; retry
    86400      ; expire
    60         ; minimum
)

@ IN NS ns.{{ VPN_DNS_ZONE }}.
{{ VPN_NETWORK | iplib_first_addr | iplib_ptr }}.     IN PTR ns.{{ VPN_DNS_ZONE }}.
